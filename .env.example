# Contact form email (copy to .env.local and fill in; never commit real values)

# SMTP server. Google Workspace: smtp.gmail.com, port 465, and an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# "true" for port 465 (SSL); leave unset for 587 (STARTTLS).
SMTP_SECURE=true
SMTP_USER=website@newron.ai
SMTP_PASS=your-app-password

# Where enquiries are delivered (comma-separate multiple addresses).
CONTACT_TO=hello@newron.ai
# Optional sender shown in the inbox. Defaults to "ArthaLM website <SMTP_USER>".
CONTACT_FROM="ArthaLM website <website@newron.ai>"
